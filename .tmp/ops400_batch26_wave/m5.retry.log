const banned=fs.readFileSync('config/banned_words.txt','utf8').split(/\\r?\\n/).map(l=>l.trim()).filter(Boolean).map(l=>l.split(' > ')[0].trim()).filter(Boolean);
const escape=s=>s.replace(/[.*+?"'^${}()|['"\\]\\\\]/g,'\\\\"'$&'"');
const found=[];
for (const w of banned) {
  const re=new RegExp("'`(''^|[''^A-Za-zÁÉÍÓÚáéíóúÑñ])${escape(w)}([''^A-Za-zÁÉÍÓÚáéíóúÑñ]|$)`, '"'i');
  if (re.test(text)) found.push(w);
}
console.log(found.length ? 'BANNED_FOUND ' + found.join(', ') : 'BANNED_OK');
