import json, re, glob
from pathlib import Path
cand = json.loads(Path('/tmp/m2_batch26_candidate.json').read_text())
existing = []
for path in glob.glob('01_processed_json_ops400/module2/block-OPS400-M2/batch-*.json'):
    if path.endswith('batch-26.json'):
        continue
    existing.extend(json.loads(Path(path).read_text()))

def tok(s):
    s = s.lower()
    s = re.sub(r'["'^a-záéíóúñ0-9 ]+'"', ' ', s)
    return set(w for w in s.split() if len(w) > 3)
for item in cand:
    ts = tok(item['scenario'])
    best = (0,None,None)
    for ex in existing:
        es = tok(ex['scenario'])
        score = len(ts & es)/(len(ts | es) or 1)
        if score > best[0]:
            best = (score, ex['id'], ex['scenario'])
    print(item['id'], f'{best[0]:.3f}', best[1])
