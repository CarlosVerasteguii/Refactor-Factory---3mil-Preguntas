for field in ['integrity_correct','pragmatic_distractor','evasive_distractor','rationalized_distractor']:
    starts = [item['options_structured'][field].split()[0].lower() for item in data]
    from collections import Counter
    c = Counter(starts)
    repeats[field] = c.most_common(5)
print('starts=', repeats)
