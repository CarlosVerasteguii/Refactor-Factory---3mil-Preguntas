import json, glob, re, itertools
path='01_processed_json_ops400/module1/block-OPS400-M1/batch-26.json'
with open(path, encoding='utf-8') as f:
    items=json.load(f)
assert len(items)==20
ids=[x['id'] for x in items]
assert len(ids)==len(set(ids))==20
for idx,item in enumerate(items, start=501):
    assert item['id']==f'block-OPS400-M1-q{idx}'
    assert item['module_id']==1 and item['block_id']=='OPS400-M1' and item['type']=='options'
    assert set(item['options_structured'])=={'integrity_correct','pragmatic_distractor','evasive_distractor','rationalized_distractor'}
stop={'el','la','los','las','un','una','unos','unas','de','del','y','o','a','al','que','te','tu','tú','en','por','para','con','se','lo','le','ya','no','sí','si','porque','qué','haces','como','más','menos'}
def toks(s):
    return {w for w in re.findall(r'[a-záéíóúñ]+', s.lower()) if w not in stop and len(w)>2}
within=[]
for a,b in itertools.combinations(items,2):
    ta,tb=toks(a['scenario']),toks(b['scenario'])
    j=len(ta&tb)/max(1,len(ta|tb))
    if j>=0.42:
        within.append((round(j,3),a['id'],b['id'],sorted(ta&tb)))
prev=[]
for prev_path in sorted(glob.glob('01_processed_json_ops400/module1/block-OPS400-M1/batch-*.json')):
    if prev_path.endswith('batch-26.json'):
        continue
    with open(prev_path, encoding='utf-8') as f:
        prev.extend(json.load(f))
for item in items:
    ti=toks(item['scenario'])
    best=(0,None)
    for p in prev:
        tp=toks(p['scenario'])
        j=len(ti&tp)/max(1,len(ti|tp))
        if j>best[0]:
            best=(j,p['id'])
    print(f\"{item['id']}\\tbest_prev={best[0]:.3f}\\t{best[1]}\")
print('within_batch_flags', len(within))
for row in within:
    print('WITHIN', *row)
